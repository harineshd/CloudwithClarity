# Copy this file to .env for local (non-docker) runs.
# When running via docker-compose, these are injected by docker-compose.yml instead.

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=medtrack
DB_PASSWORD=medtrack_pw
DB_NAME=medtrack

JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=8h

# Seeded on first boot if the users table is empty
SEED_ADMIN_EMAIL=admin@medtrack.local
SEED_ADMIN_PASSWORD=admin123
